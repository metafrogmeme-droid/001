.env
.env.*
!.env.example
# Unlike .gitignore, dockerignore patterns are anchored at the build context
# root, so the bare `.env` above does NOT cover token/.env. Solana key material
# must never reach an image layer — the mint/presale/LP authority lives here.
**/.env
!**/.env.example
**/.keys/
**/*keypair*.json
**/id.json
target/
.git
.github
.gitignore
data/
logs/
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
node_modules
*.tar.gz
*.egg-info
demo/
docs/
website/demo-recording.*
*.md
!README.md
!LICENSE
!NOTICE
