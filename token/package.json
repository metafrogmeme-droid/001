{
  "name": "rclaw-token",
  "version": "0.1.0-draft",
  "private": true,
  "type": "module",
  "description": "DRAFT / DEVNET-ONLY tooling to mint/verify the $RCLAW SPL Token-2022 and run a Metaplex Genesis fixed-price presale. Not for mainnet without the legal review + audit gates in docs/TOKEN_ROADMAP.md. Also holds the read-only plan and verify commands for the Smithii presale (the venue of record): the verify command reads mainnet, and nothing in either signs or sends.",
  "license": "BUSL-1.1",
  "scripts": {
    "create": "node scripts/create_token.mjs",
    "verify": "node scripts/verify_token.mjs",
    "keygen": "node scripts/keygen.mjs",
    "presale:plan": "node presale/genesis_presale.mjs plan",
    "presale:whitelist": "node presale/genesis_presale.mjs whitelist",
    "presale:create": "node presale/genesis_presale.mjs create",
    "presale:liquidity": "node presale/genesis_presale.mjs liquidity",
    "presale:allocate": "node presale/genesis_presale.mjs allocate",
    "presale:finalize": "node presale/genesis_presale.mjs finalize",
    "presale:deposit": "node presale/genesis_presale.mjs deposit",
    "presale:claim": "node presale/genesis_presale.mjs claim",
    "presale:withdraw": "node presale/genesis_presale.mjs withdraw",
    "presale:withdraw-unsold": "node presale/genesis_presale.mjs withdraw-unsold",
    "e2e:plan": "node e2e/devnet_dryrun.mjs --dry",
    "e2e:dryrun": "node e2e/devnet_dryrun.mjs",
    "bridge:plan": "node bridge/ntt_bridge.mjs plan",
    "bridge:transfer": "node bridge/ntt_bridge.mjs transfer",
    "presale:trigger": "node presale/genesis_presale.mjs trigger",
    "test": "node --test presale/*.test.mjs scripts/*.test.mjs",
    "test:network": "RUN_NETWORK_TESTS=1 node --test presale/*.test.mjs scripts/*.test.mjs",
    "audit:gate": "node scripts/audit_gate.mjs",
    "audit:baseline": "node scripts/audit_gate.mjs --update",
    "programs:inventory": "node scripts/program_inventory.mjs",
    "programs:baseline": "node scripts/program_inventory.mjs --update",
    "e2e:whitelist": "node e2e/whitelist_e2e.mjs",
    "presale:verify": "node presale/genesis_presale.mjs verify",
    "presale:smithii-plan": "node presale/smithii_plan.mjs",
    "presale:smithii-verify": "node presale/smithii_verify.mjs",
    "presale:locks-plan": "node presale/locks_plan.mjs"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@metaplex-foundation/genesis": "0.40.0",
    "@metaplex-foundation/mpl-token-metadata": "3.4.0",
    "@metaplex-foundation/mpl-toolbox": "0.10.0",
    "@metaplex-foundation/umi": "1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "1.5.1",
    "@solana/spl-token": "0.4.15",
    "@solana/spl-token-metadata": "0.1.6",
    "@solana/web3.js": "1.98.4",
    "@wormhole-foundation/sdk-connect": "5.2.0",
    "@wormhole-foundation/sdk-evm": "5.2.0",
    "@wormhole-foundation/sdk-evm-ntt": "7.2.0",
    "@wormhole-foundation/sdk-solana": "5.2.0",
    "@wormhole-foundation/sdk-solana-ntt": "7.2.0"
  },
  "overrides": {
    "axios": "1.20.0",
    "protobufjs": "^7.6.3",
    "jayson": "5.0.0"
  }
}
