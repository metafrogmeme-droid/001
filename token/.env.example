# $RCLAW token tooling — DEVNET / DRAFT only. Never put a mainnet key here.
#
# Path to a Solana keypair JSON (array of 64 ints), e.g. ~/.config/solana/id.json,
# or one generated by `npm run keygen` (writes ./.keys/mint-payer.json).
KEYPAIR_PATH=./.keys/mint-payer.json

# RPC endpoint. Defaults to Solana devnet if unset. Do NOT point at mainnet-beta
# for this draft tooling — mainnet is gated behind legal review + audit (see roadmap).
RPC_URL=https://api.devnet.solana.com

# Optional: cluster label used only for log/verify output ("devnet" | "testnet").
CLUSTER=devnet
