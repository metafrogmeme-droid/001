{
  "//": "GENERATED by scripts/render_secret_shapes.py from bot/utils/secret_shapes.py — do not edit. tests/test_the_website_reads_this_vocabulary.py fails if it is stale.",
  "redacted": "***REDACTED***",
  "rows": [
    {
      "name": "telegram_bot_token",
      "pattern": "(?:bot)?\\d{6,12}:[A-Za-z0-9_-]{20,}",
      "ignorecase": false,
      "replacement": {
        "kind": "redact"
      },
      "example": "https://api.telegram.org/bot123456789:AAHfjdkslfjdkslfjdkslfjdkslfjdksl/sendMessage",
      "decoy": "closed 2026-09-14 12:30:15 UTC at 63,000.00"
    },
    {
      "name": "bearer_token",
      "pattern": "\\b(Bearer)\\s+([A-Za-z0-9._~+/=-]{16,})",
      "ignorecase": false,
      "replacement": {
        "kind": "keep_words",
        "label": 1,
        "value": 2,
        "sep": " "
      },
      "example": "Authorization: Bearer sk-ant-api03-AbCdEfGhIjKlMnOpQrStUvWxYz0123456789",
      "decoy": "the bearer of responsibilities"
    },
    {
      "name": "provider_key",
      "pattern": "\\b(?:sk-[A-Za-z0-9_-]{20,}|xai-[A-Za-z0-9_-]{20,}|gsk_[A-Za-z0-9_-]{20,}|pplx-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{30,})",
      "ignorecase": false,
      "replacement": {
        "kind": "redact"
      },
      "example": "provider rejected sk-proj-AbCdEfGhIjKlMnOpQrStUvWxYz0123456789abcdefghijk",
      "decoy": "sk-8 is a sticker, gsk_ alone is not a key, AIzaShort neither"
    },
    {
      "name": "jwt",
      "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}",
      "ignorecase": false,
      "replacement": {
        "kind": "redact"
      },
      "example": "session eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c",
      "decoy": "eyJ is how every JWT header starts"
    },
    {
      "name": "named_key_value",
      "pattern": "(api[_-]?key|api[_-]?secret|passphrase|password|token|secret|credential)\\s*[=:]\\s*['\\\"]?([^\\s'\\\"]{4,})",
      "ignorecase": true,
      "replacement": {
        "kind": "template",
        "template": "\\1=***REDACTED***"
      },
      "example": "auth failed: api_key=sk-abcdefghijklmnopqrs",
      "decoy": "token: BTC"
    },
    {
      "name": "prose_key_label",
      "pattern": "\\b((?:api|private|secret|signing|master)\\s+key)\\s*[=:]\\s*['\\\"]?([A-Za-z0-9+/=_.:-]{8,})",
      "ignorecase": true,
      "replacement": {
        "kind": "keep_words",
        "label": 1,
        "value": 2,
        "sep": "="
      },
      "example": "api key: bg_1234567890abcdef1234567890abcdef",
      "decoy": "api key: not configured"
    },
    {
      "name": "env_name_value",
      "pattern": "\\b([A-Z][A-Z0-9_]*(?:KEY|SECRET|SECRETS|TOKEN|PASSWORD|PASSPHRASE|CREDS?|CREDENTIALS?)(?:_[A-Z0-9_]+)?)\\s*[=:]\\s*['\\\"]?([^\\s'\\\"<>]{8,})",
      "ignorecase": false,
      "replacement": {
        "kind": "keep_words",
        "label": 1,
        "value": 2,
        "sep": "="
      },
      "example": "RUNECLAW_SECRETS_KEY=Zm9vYmFyYmF6cXV4Zm9vYmFyYmF6cXV4Zm9vYmFyYmF6cXV4YQ==",
      "decoy": "Key: <code>BG-1a2b…f9</code> · WEB_CREDS_KEY=required"
    },
    {
      "name": "secret_query_param",
      "pattern": "([?&](?:api[_-]?key|apikey|key|secret|token|access_token|auth|sig|sign|signature|passphrase|password|private_key)=)[^&\\s\\\"'<>]+",
      "ignorecase": true,
      "replacement": {
        "kind": "template",
        "template": "\\1***REDACTED***"
      },
      "example": "GET https://api.bitget.com/api/v2/mix?apiKey=bg_1234567890abcdef&sign=ZZZ failed",
      "decoy": "https://www.humanoid-traders.com/api/insight?symbol=BTC%2FUSDT&v=12"
    }
  ]
}
