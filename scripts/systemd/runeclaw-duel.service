# systemd unit for the Daily Duel's own Telegram bot (python3 -m bot.duel_bot).
#
# THE OPTIONAL THIRD PROCESS.
#
# The duel bot runs beside bot.main on its own BotFather token (DUEL_BOT_TOKEN
# in the bot's .env) with no engine, no venue and none of the main bot's state;
# it reads the card and records calls through the website's bot channel. It is
# installed only on a box that has created that bot: the status script lists
# it as OPTIONAL when it is not.
#
# A missing token, or one equal to TELEGRAM_BOT_TOKEN (two processes polling
# one token conflict forever), exits 78 (EX_CONFIG). RestartPreventExitStatus
# below keeps that from becoming a fifteen-second restart loop: the unit stops
# with one loud line in its journal, and `runeclaw-status.sh` shows it DOWN.
# Every other exit restarts, as the other units do.
#
# Install:
#   sudo cp runeclaw-duel.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now runeclaw-duel
#   scripts/systemd/runeclaw-status.sh
#
# Adjust User=, WorkingDirectory= and the ExecStart path to match the box.
# ExecStart is <repo>/.venv/bin/python (Python 3.11). /usr/bin/python3 on
# this host is 3.10. See scripts/systemd/README.md for user units.

[Unit]
Description=RUNECLAW Daily Duel bot (its own Telegram token; health on :8081)
After=network-online.target
Wants=network-online.target

# In [Unit], NOT [Service] — systemd discards it from [Service] with "Unknown
# key name ... ignoring". See the longer note in runeclaw-bot.service.
StartLimitIntervalSec=0

[Service]
Type=simple
User=mulerun
WorkingDirectory=/home/mulerun/runeclaw

# Idempotent; restores .env (where the token lives) before the process reads it.
ExecStartPre=/home/mulerun/runeclaw/deploy.sh

# The repo venv. /usr/bin/python3 on this host is 3.10; the lock needs 3.11.
ExecStart=/home/mulerun/runeclaw/.venv/bin/python -m bot.duel_bot

# /health answers 200 only while the poller is running: a process that exists
# but no longer polls is not a healthy bot. Generous, like the others.
ExecStartPost=/home/mulerun/runeclaw/scripts/systemd/wait_for_port.sh http://127.0.0.1:8081/health 120

# Never give up — see StartLimitIntervalSec=0 in [Unit] above — except on the
# one exit that means "not configured", which restarting cannot fix.
Restart=always
RestartSec=15
RestartPreventExitStatus=78

#   journalctl -u runeclaw-duel -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=runeclaw-duel

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
