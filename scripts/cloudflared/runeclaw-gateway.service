# systemd unit for the RUNECLAW gateway tunnel.
#
# Naming the tunnel fixes the URL churn. It does NOT fix the tunnel being
# DOWN — those are two separate failure modes, and only one of them is solved
# by giving the hostname a stable name. A named tunnel whose process died at
# 03:00 and was never restarted is just as unreachable as a quick tunnel whose
# URL rotated. This unit is the other half.
#
# Install:
#   sudo cp runeclaw-gateway.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now runeclaw-gateway
#   systemctl status runeclaw-gateway
#
# Adjust User= and the config path if the bot does not run as `mulerun`.

[Unit]
Description=RUNECLAW bot gateway (Cloudflare named tunnel)
After=network-online.target
Wants=network-online.target

# THIS LINE WAS IN [Service] AND SYSTEMD WAS THROWING IT AWAY.
#
# Verified against systemd 255 with `systemd-analyze verify`:
#
#   Unknown key name 'StartLimitIntervalSec' in section 'Service', ignoring.
#
# So the tunnel that says below "an unattended tunnel that gives up after five
# attempts is the failure this unit exists to prevent" gave up after five
# attempts — the default burst limit applied in full, on the unit written to
# disable it. A directive in the wrong section is not a syntax error; it is
# silently discarded, which is the same shape as a guard that is present and
# never reached.
#
# Found while writing the bot/bridge units, by asking which OTHER unit makes
# the same claim before calling the new ones done. Reinstall to apply:
#   sudo cp runeclaw-gateway.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart runeclaw-gateway
StartLimitIntervalSec=0

[Service]
Type=notify
User=mulerun
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /home/mulerun/.cloudflared/config.yml tunnel run
# Come back from a crash, and keep coming back — an unattended tunnel that
# gives up after five attempts is the failure this unit exists to prevent.
Restart=always
RestartSec=5
# The tunnel needs no privileges beyond a socket to localhost.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
