# --------------------------------------------------------------------------
# RUNECLAW .gitignore
# Python + Node + project-specific exclusions
# --------------------------------------------------------------------------

# -- Python --
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pytest_cache/

# -- Node / Next.js --
node_modules/
.next/
out/
.nuxt/
.cache/

# -- Coverage / test artifacts (produced by the CI gate) --
.coverage
.coverage.*
htmlcov/
coverage.xml
.pytest_cache/

# -- Environment & secrets --
.env
.env.*
!.env.example

# -- Solana key material — deny by default, no exceptions --
# token/.gitignore covers token/.keys/, but only for files under token/. A
# keypair written anywhere else (an Anchor build's target/deploy/, a stray
# id.json, an operator's scratch copy) was previously committable.
.keys/
**/.keys/
*keypair*.json
id.json
target/deploy/*-keypair.json

# -- Logs --
logs/*.jsonl
# closed_trades.json and live_trading_log.csv are runtime state;
# they live in the persistent store via deploy.sh, not in git.
logs/*.jsonl.*
*.log


# audit_chain.jsonl is a runtime artifact rewritten on every run/test (and seeded
# fresh from GENESIS when absent), so it is intentionally NOT tracked.

# -- Training data & artifacts --
ollama/
v6_data/
AUDIT_REPORT*.md
# Full-universe deep backtest raw results (1.6 MB, regenerable, non-reproducible
# per the wall-clock session finding). The committed summary lives in docs/.
backtest_deep_full_results.json

# -- IDE --
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -- Docker --
docker-compose.override.yml

# -- Project-specific --
*.db
*.sqlite3
# Everything under data/ is runtime state and stays out of git.
#
# There used to be a `!data/benchmark/` negation here, to let the FROZEN
# benchmark snapshot be committed. It never once worked. On a deployed box
# deploy.sh makes data/ a SYMLINK into ~/runeclaw-persist/, and git does not
# traverse symlinks — so `git add -f data/benchmark/...` silently adds nothing,
# and every fresh clone (CI included) got a repository whose own benchmark data
# could not be committed into it. Five tests failed on main for that reason
# alone, and the negation read like the problem was already solved.
#
# The snapshot now lives at top-level benchmark/, which is tracked. That is the
# right split rather than a workaround: data/ holds runtime state that must
# never be committed — which is why it is a symlink — while the frozen
# benchmark is a version-controlled build input that must always be. One
# directory could not be both. See bot/backtest/snapshot.benchmark_root.
#
# `data/*` rather than `data/`: a directory excluded as `data/` is pruned
# before git considers any re-include, so this form is kept in case a subtree
# ever needs re-including again.
data/*
# Auto-generated auth secret (never commit; regenerated per-deployment if absent)
**/.jwt_secret
# .github/ is intentionally tracked now (CI workflows live here). Only the
# private CI backup dir stays ignored.
.github_ci_backup/
.playwright-cli/

# Build stamp written at image build time (see Dockerfile / app/lib/version.js)
build-info.json
app/build-info.json

# Solana / Anchor programs (programs/*) — build output and local validator state
target/
.anchor/
test-ledger/

# The persistent store links. deploy.sh replaces `data` and `logs` with
# SYMLINKS into $PERSIST_DIR, and `data/*` does not match a symlink named
# `data` — so a `git add -A` after running deploy.sh commits a link pointing at
# whatever that machine's store path happened to be. Committed once, 2026-08-17,
# aimed at a /tmp directory: a `git reset --hard` on the box would then have
# replaced the real state links with dead ones.
/data
/logs
