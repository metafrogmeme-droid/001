# The INPUT of requirements-piptools.txt: pip-tools, the compiler of every
# hashed lock in this repository, itself included.
#
#   python3 scripts/compile_locks.py            regenerate every hashed lock
#
# Installed by the "Dependency lock (pip-compile)" job in ci.yml and by
# whoever regenerates a lock, into an environment of its own:
#
#   python3.11 -m venv ~/.venvs/runeclaw-locks
#   ~/.venvs/runeclaw-locks/bin/pip install --require-hashes -r requirements-piptools.txt
#   ~/.venvs/runeclaw-locks/bin/python scripts/compile_locks.py
#
# scripts/compile_locks.py refuses to compile under any other pip-tools or
# pip than the two pinned here: a different resolver is a different file.
pip-tools==7.7.0

# ── Transitives ─────────────────────────────────────────────────────────────
build==1.6.1
click==8.5.1
packaging==26.3
pyproject-hooks==1.3.3
# pip-tools takes any wheel. This is the version requirements.in pins, so
# there is one wheel across the locks (tests/test_manifests_agree.py). It was
# 0.48.0 here, the newest on the day this file was written, until 2026-11-20.
wheel==0.46.3
